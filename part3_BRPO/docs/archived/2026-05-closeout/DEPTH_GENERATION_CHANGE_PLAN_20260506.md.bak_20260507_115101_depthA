## 4. 详细实现方案

### 4.1 新增函数: `get_mast3r_direct_depth()`

**文件**: `runtime_exact_backend.py`

```python
def get_mast3r_direct_depth(
    *,
    pseudo_gt_rgb_path: str | Path,
    ref_rgb_path: str | Path,
    pseudo_state: dict[str, Any],
    ref_state: dict[str, Any],
    ref_depth: np.ndarray,  # 用于 scale correction
    matcher: Dense3DMatcher,
    size: int = 512,
) -> dict[str, np.ndarray]:
    """使用 pseudo GT RGB + ref RGB 获取 MASt3R 直接深度.
    
    Args:
        pseudo_gt_rgb_path: Pseudo 帧 GT RGB 路径
        ref_rgb_path: Reference KF RGB 路径
        pseudo_state: Pseudo 帧 state dict
        ref_state: Reference 帧 state dict
        ref_depth: Reference 帧的 render depth (用于 scale correction)
        matcher: Dense3DMatcher 实例
        size: MASt3R 输入尺寸
        
    Returns:
        {
            "depth_raw": pts3d_1.z (MASt3R 原始深度),
            "depth_corrected": scale-corrected depth,
            "confidence": MASt3R confidence,
            "scale_factor": scale correction factor,
        }
    """
    # 1. 调用 MASt3R
    bundle = matcher.forwarder.run_pair(
        img1_path=str(pseudo_gt_rgb_path),
        img2_path=str(ref_rgb_path),
        size=int(size),
    )
    
    # 2. 提取 pts3d_1.z (pseudo 在自己坐标系下的深度)
    pts3d_1 = np.asarray(bundle.pts3d_1, dtype=np.float32)
    depth_raw = pts3d_1[..., 2]  # Z 坐标
    
    # 3. 提取 confidence
    conf1 = np.asarray(bundle.conf1, dtype=np.float32)
    
    # 4. Scale correction: 对齐到 ref depth 的 scale
    # 方法: 在重叠区域计算 scale factor
    pts3d_2_in_1 = np.asarray(bundle.pts3d_2_in_1, dtype=np.float32)
    ref_projected_depth = pts3d_2_in_1[..., 2]
    
    # 使用 high-confidence 区域计算 scale ratio
    valid_mask = (conf1 > 1e-6) & (depth_raw > 1e-6) & (ref_projected_depth > 1e-6)
    if valid_mask.sum() > 100:
        # Scale = median(ref_projected_depth / depth_raw)
        # 这样 corrected_depth = depth_raw * scale ≈ ref_projected_depth
        scale_ratios = ref_projected_depth[valid_mask] / np.maximum(depth_raw[valid_mask], 1e-6)
        scale_factor = float(np.median(scale_ratios))
    else:
        # Fallback: 使用 ref depth median
        scale_factor = 1.0
    
    # 5. Apply scale correction
    depth_corrected = depth_raw * scale_factor
    
    # 6. Clip and validate
    depth_corrected = np.clip(depth_corrected, 0.0, 100.0)
    
    return {
        "depth_raw": depth_raw,
        "depth_corrected": depth_corrected,
        "confidence": conf1,
        "scale_factor": scale_factor,
        "pts3d_1": pts3d_1,
        "pts3d_2_in_1": pts3d_2_in_1,
    }
```

### 4.2 双侧深度融合

```python
def fuse_dual_mast3r_depth(
    *,
    left_depth: np.ndarray,
    right_depth: np.ndarray,
    left_conf: np.ndarray,
    right_conf: np.ndarray,
    left_ref_depth: np.ndarray,
    right_ref_depth: np.ndarray,
    pseudo_state: dict[str, Any],
    left_state: dict[str, Any],
    right_state: dict[str, Any],
    tau_depth_consistency: float = 0.15,
) -> dict[str, np.ndarray]:
    """融合双侧 MASt3R 直接深度.
    
    Args:
        left_depth: 左侧 MASt3R 深度 (scale-corrected)
        right_depth: 右侧 MASt3R 深度 (scale-corrected)
        left_conf: 左侧 MASt3R confidence
        right_conf: 右侧 MASt3R confidence
        left_ref_depth: 左侧 ref render depth
        right_ref_depth: 右侧 ref render depth
        pseudo_state: Pseudo 帧 state
        left_state: 左侧 ref state
        right_state: 右侧 ref state
        tau_depth_consistency: 深度一致性阈值
        
    Returns:
        {
            "fused_depth": 融合深度,
            "fused_confidence": 融合 confidence,
            "fusion_weight_left": 左侧权重,
            "fusion_weight_right": 右侧权重,
        }
    """
    h, w = left_depth.shape
    
    # 1. 计算重叠区域的 depth consistency
    overlap_mask = (left_conf > 1e-6) & (right_conf > 1e-6)
    
    # 2. 在重叠区域检查 depth consistency
    depth_diff = np.abs(left_depth - right_depth) / np.maximum(np.minimum(left_depth, right_depth), 1e-6)
    consistent_mask = overlap_mask & (depth_diff < tau_depth_consistency)
    
    # 3. 计算融合权重
    # Priority: consistent region > single-side valid
    w_left = np.zeros((h, w), dtype=np.float32)
    w_right = np.zeros((h, w), dtype=np.float32)
    
    # Consistent region: 使用 confidence 比例
    if consistent_mask.any():
        total_conf = left_conf[consistent_mask] + right_conf[consistent_mask]
        w_left[consistent_mask] = left_conf[consistent_mask] / np.maximum(total_conf, 1e-6)
        w_right[consistent_mask] = right_conf[consistent_mask] / np.maximum(total_conf, 1e-6)
    
    # Left-only region
    left_only = (left_conf > 1e-6) & (right_conf <= 1e-6)
    w_left[left_only] = 1.0
    
    # Right-only region
    right_only = (right_conf > 1e-6) & (left_conf <= 1e-6)
    w_right[right_only] = 1.0
    
    # 4. Fusion
    fused_depth = w_left * left_depth + w_right * right_depth
    
    # 5. Fusion confidence = weighted average
    fused_conf = w_left * left_conf + w_right * right_conf
    
    return {
        "fused_depth": fused_depth,
        "fused_confidence": fused_conf,
        "fusion_weight_left": w_left,
        "fusion_weight_right": w_right,
        "consistent_mask": consistent_mask,
    }
```

