    'seed': 0,
}


def generate_config(exp_name: str, modifications: dict, output_dir: Path):
    """Generate a config file for the experiment."""
    config = dict(BASE_CONFIG)

    # Set Results section
    config['Results'] = {
        'color_refinement': True,
        'eval_rendering': True,
        'export_internal_cache': True,
        'global_BA': False,
        'save_dir': str(output_dir),
        'save_results': True,
        'save_trj': True,
        'save_trj_kf_intv': 10,
        'use_gui': False,
        'use_wandb': False,
    }

    # Add BRPO config with modifications
    brpo_cfg = dict(BRPO_CONFIG_TEMPLATE)
    brpo_cfg.update(modifications)
    brpo_cfg['debug_export_root'] = str(output_dir / 'brpo_debug')
    config['Results']['brpo_online_mapping'] = brpo_cfg

    # Save config
    config_path = output_dir / 'config.yml'
    with open(config_path, 'w') as f:
        yaml.dump(config, f, default_flow_style=False, sort_keys=False)

    return config_path


def main():
    base_output = Path(OUTPUT_BASE)

    experiments = [
        # D0: Baseline (no pseudo mapping)
        ('D0_baseline', {
            'num_iterations': 20,
            'pseudo_map_iters': 0,  # No pseudo mapping
        }),
        # D1: Pose gradient fix validation (Adam)
        ('D1_pose_fix', {
            'num_iterations': 20,
            'pseudo_map_iters': 20,
            'use_gauss_newton': False,  # Use Adam with fix
        }),
        # D2: Gauss-Newton validation
        ('D2_gauss_newton', {
            'num_iterations': 20,
            'pseudo_map_iters': 20,
            'use_gauss_newton': True,
            'gn_max_iters': 5,
            'gn_damping': 0.01,
            'gn_every_n_steps': 1,
        }),
        # D3: Scale regularization (lambda_scale increased)
        ('D3_scale_reg', {
            'num_iterations': 20,
            'pseudo_map_iters': 20,
            'lambda_scale': 0.1,  # Increased from 0.01
            'use_gauss_newton': False,
        }),
        # D4: Combined (GN + Scale)
        ('D4_gn_scale', {
            'num_iterations': 20,
            'pseudo_map_iters': 20,
            'use_gauss_newton': True,
            'gn_max_iters': 5,
            'gn_damping': 0.01,
            'lambda_scale': 0.1,
        }),
    ]

    for exp_name, mods in experiments:
        output_dir = base_output / exp_name
        output_dir.mkdir(parents=True, exist_ok=True)

        config_path = generate_config(exp_name, mods, output_dir)
        print(f"Generated config for {exp_name}: {config_path}")

        # Print key settings for verification
        print(f"  pseudo_map_iters: {mods.get('pseudo_map_iters', 'N/A')}")
        print(f"  use_gauss_newton: {mods.get('use_gauss_newton', False)}")
        print(f"  lambda_scale: {mods.get('lambda_scale', 0.01)}")
        print()


if __name__ == '__main__':
    main()